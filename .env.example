# Everything here is optional. Orbita works fully offline without any of it.

# Cloud sync (your own Supabase project, see docs/CLOUD.md). Both are public values: use the publishable (anon) key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Set to "off" to hide the cloud even if the two values above are present.
# VITE_CLOUD=off

# Use the deterministic stand-in model and speech recognition (demos, tests, screenshots). No keys needed.
# VITE_MOCK_AI=1
