{
  "name": "orbita",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Orbita — a personal, local-first system for making sense of life and work: voice notes become decisions, commitments, ideas and predictions.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "node scripts/i18n-check.mjs",
    "check": "npm run typecheck && npm run i18n:check && npm test && npm run build",
    "icons": "node scripts/generate-icons.ts",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^4.0.1",
    "minisearch": "^7.1.2",
    "motion": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "~1.56.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.0",
    "vite": "^6.4.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.0"
  },
  "license": "MIT",
  "keywords": [
    "pwa",
    "local-first",
    "journal",
    "voice",
    "ai",
    "react",
    "typescript",
    "indexeddb"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxbzd/Orbita.git"
  },
  "homepage": "https://github.com/maxbzd/Orbita#readme",
  "bugs": {
    "url": "https://github.com/maxbzd/Orbita/issues"
  }
}
