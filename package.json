{
  "name": "orbita",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Orbita — a personal, local-first system for making sense of life and work: voice notes become decisions, commitments, ideas and predictions.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome lint src scripts",
    "lint:fix": "biome lint --write src scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "node scripts/i18n-check.mjs",
    "check": "npm run typecheck && npm run i18n:check && npm test && npm run build",
    "icons": "node scripts/generate-icons.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "e2e:vault": "node scripts/e2e-vault.mjs",
    "e2e:audit": "node scripts/e2e-audit.mjs",
    "e2e:quota": "node scripts/e2e-quota.mjs",
    "e2e:update": "node scripts/e2e-update.mjs",
    "e2e:scale": "node scripts/e2e-scale.mjs",
    "e2e:idle": "node scripts/e2e-idle.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "licenses": "node scripts/write-licenses.mjs",
    "check:reproducible": "node scripts/check-reproducible.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "@supabase/supabase-js": "^2.118.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.0.1",
    "fake-indexeddb": "^6.2.7",
    "minisearch": "^7.2.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "~1.64.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "acorn": "^8.19.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "keywords": [
    "pwa",
    "local-first",
    "journal",
    "voice",
    "ai",
    "react",
    "typescript",
    "indexeddb"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxbzd/Orbita.git"
  },
  "homepage": "https://github.com/maxbzd/Orbita#readme",
  "bugs": {
    "url": "https://github.com/maxbzd/Orbita/issues"
  }
}
