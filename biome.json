{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": false
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "scripts/**/*.mjs",
      "*.ts"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useTemplate": "off",
        "noNonNullAssertion": "off",
        "useImportType": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "off",
        "noControlCharactersInRegex": "off",
        "useIterableCallbackReturn": "warn",
        "noAssignInExpressions": "warn",
        "noConfusingVoidType": "warn",
        "noImplicitAnyLet": "warn",
        "noExportsInTest": "warn"
      },
      "a11y": {
        "noAutofocus": "off",
        "useValidAnchor": "off",
        "useKeyWithClickEvents": "off",
        "noStaticElementInteractions": "off",
        "useSemanticElements": "off",
        "noAriaHiddenOnFocusable": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "noNoninteractiveTabindex": "warn",
        "noNoninteractiveElementToInteractiveRole": "warn",
        "useFocusableInteractive": "warn",
        "useMediaCaption": "warn",
        "noSvgWithoutTitle": "warn",
        "noRedundantRoles": "warn"
      },
      "complexity": {
        "noForEach": "off",
        "noImportantStyles": "off",
        "useOptionalChain": "warn",
        "noUselessFragments": "warn",
        "noUselessContinue": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "off",
        "useHookAtTopLevel": "off",
        "noVoidTypeReturn": "warn"
      }
    }
  }
}
